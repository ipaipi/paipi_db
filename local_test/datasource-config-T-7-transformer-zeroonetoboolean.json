{
  "job": {
    "sqlMode": 2,
    "setting": {
      "speed": {
        "channel": 1
      },
      "reportPath": "local_test/temp/report_file.json",
      "enablePreCheck": true,
      "enablePostCheck": true
    },
    "content": [
      {
        "reader": {
          "name": "Mysql",
          "parameter": {
            "connection": {
              "ip": "192.168.232.100",
              "port": "3306",
              "username": "root",
              "password": "admin",
              "database": "demo"
            },
            "table": "test_table_bool",
            "column": [
              "id",
              "name",
              "flag"
            ]
          }
        },
        "writer": {
          "name": "TxtFile",
          "parameter": {
            "filePath": "local_test/temp/test_table_bool.csv",
            "sep": ",",
            "skipHeader": true
          }
        },
        "transformer": [
          {
            "name": "zeroonetoboolean",
            "parameter": {
              "columnIndex": [
                2
              ]
            }
          }
        ]
      }
    ]
  }
} 